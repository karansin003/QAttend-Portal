rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.token.email)).data;
    }

    function isAdmin() {
      return isSignedIn() && myProfile().role == "admin";
    }

    function isCR() {
      return isSignedIn() && myProfile().role == "cr";
    }

    function mySection() {
      return myProfile().section;
    }

    match /users/{email} {
      allow read: if isSignedIn() && request.auth.token.email == email;
      allow read, write: if isAdmin();
    }

    match /sections/{sectionId}/subjects/{subjectId} {
      allow read: if isAdmin() || (isCR() && mySection() == sectionId);
      allow write: if isAdmin();
    }

    match /sections/{sectionId}/students/{studentId} {
      allow read: if isAdmin() || (isCR() && mySection() == sectionId);
      allow write: if isAdmin();
    }

    match /sections/{sectionId}/attendance/{recordId} {
      allow read, write: if isAdmin() || (isCR() && mySection() == sectionId);
    }

    // CR can submit a request only for their assigned section.
    // Admin can review/update/delete requests.
    match /requests/{requestId} {
      allow create: if isCR()
        && request.resource.data.requestedBy == request.auth.token.email
        && request.resource.data.section == mySection();

      allow read: if isAdmin()
        || (isCR() && resource.data.requestedBy == request.auth.token.email);

      allow update, delete: if isAdmin();
    }
  }
}
