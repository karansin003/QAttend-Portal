rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.token.email)).data;
    }

    function isAdmin() {
      return isSignedIn() && myProfile().role == "admin";
    }

    function isCR() {
      return isSignedIn() && myProfile().role == "cr";
    }

    function mySection() {
      return myProfile().section;
    }

    // SECTION CATALOG / METADATA
    // Admin can create and manage new sections. A CR can read metadata only for the section assigned to them.
    match /sections/{sectionId} {
      allow read: if isAdmin() || (isCR() && mySection() == sectionId);
      allow create, update, delete: if isAdmin();
    }

    // USER / ROLE PROFILES
    match /users/{email} {
      allow read: if isSignedIn() && request.auth.token.email == email;
      allow read, write: if isAdmin();
    }

    // SUBJECTS
    // Admin: full access. CR: read-only in assigned section.
    match /sections/{sectionId}/subjects/{subjectId} {
      allow read: if isAdmin() || (isCR() && mySection() == sectionId);
      allow write: if isAdmin();
    }

    // STUDENTS
    // Admin: full access. CR: read-only in assigned section.
    match /sections/{sectionId}/students/{studentId} {
      allow read: if isAdmin() || (isCR() && mySection() == sectionId);
      allow write: if isAdmin();
    }

    // ATTENDANCE
    // Admin: all sections. CR: assigned section only.
    match /sections/{sectionId}/attendance/{recordId} {
      allow read, write: if isAdmin() || (isCR() && mySection() == sectionId);
    }

    // CR CHANGE REQUESTS
    // CR can create a pending request only for its own section and its own email.
    // CR can read only its own requests (the client uses a where(requestedBy == email) query).
    // Only Admin can approve/reject/update/delete requests.
    match /requests/{requestId} {
      allow create: if isCR()
        && request.resource.data.requestedBy == request.auth.token.email
        && request.resource.data.section == mySection()
        && request.resource.data.status == "pending";

      allow read: if isAdmin()
        || (isCR() && resource.data.requestedBy == request.auth.token.email);

      allow update, delete: if isAdmin();
    }

    // ACTIVITY LOGS
    // Any signed-in user may append only their own log entries.
    // Only Admin may read/update/delete the history.
    match /activityLogs/{logId} {
      allow create: if isSignedIn()
        && request.resource.data.userEmail == request.auth.token.email;
      allow read, update, delete: if isAdmin();
    }
  }
}